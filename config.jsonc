{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "raw",
    "source": "$HOME/.config/fastfetch/fastfetch.sixel",
    "width": 24,
    "height": 12,
    "padding": {
      "right": 1
    }
  },

  "display": {
    "separator": " "
  },

  "modules": [
    {
      "type": "custom",
      "format": "╔══════════════════════════════╗"
    },
    {
      "type": "custom",
      "format": "║          󰀄 JINX            ║"
    },
    {
      "type": "custom",
      "format": "╚══════════════════════════════╝"
    },

    {
      "type": "custom",
      "format": "╔══════════════════════════════╗"
    },

    {
      "type": "os",
      "key": "║ 󰣇 OS   ",
      "format": "{name} {version} {arch}"
    },

    {
      "type": "host",
      "key": "║ 󰌢 Host ",
      "format": "Redmi 13C 5G"
    },

    {
      "type": "cpu",
      "key": "║ 󰻠 CPU  ",
      "format": "{name} @ {freq-max}"
    },

    {
      "type": "memory",
      "key": "║ 󰍛 RAM  ",
      "format": "{used} / {total}"
    },

    {
      "type": "shell",
      "key": "║  Shell",
      "format": "{pretty-name} {version}"
    },

    {
      "type": "custom",
      "format": "╚══════════════════════════════╝"
    }
  ]
}
